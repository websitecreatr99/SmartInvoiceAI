# Copied to .env by setup.sh; fill in GOOGLE_API_KEY and DOMAIN.

# Public hostname. With no domain of your own, use <public-ip-with-dashes>.sslip.io, e.g. 129-146-12-34.sslip.io
DOMAIN=

# Gemini key from https://aistudio.google.com/apikey (free tier works)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generated by setup.sh
RABBITMQ_PASSWORD=

# 2 fits comfortably in 4 OCPU / 24 GB
WORKER_REPLICAS=2
